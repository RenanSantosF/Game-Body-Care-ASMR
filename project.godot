; Engine configuration file.
; Gross to Glow - Godot 4.3

config_version=5

[application]

config/name="Gross to Glow"
config/description="Clínica nojenta e satisfatória: trate pacientes e veja o antes e depois!"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/version="1.0.4"
boot_splash/bg_color=Color(1, 0.886, 0.498, 1)
boot_splash/show_image=false

[autoload]

FTSplash="*res://addons/ft_splash/ft_splash.gd"
ScreenFit="*res://addons/play_compat/screen_fit.gd"
NoiseLib="*res://autoload/noise_lib.gd"
GameData="*res://autoload/game_data.gd"
Sfx="*res://autoload/sfx.gd"
Ads="*res://autoload/ad_manager.gd"
Icons="*res://autoload/icons.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[debug]

file_logging/enable_file_logging=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.53, 0.86, 0.85, 1)

[shader_globals]

press_pos={
"type": "vec3",
"value": Vector3(0, -10, 0)
}
press_amt={
"type": "float",
"value": 0.0
}
press_r={
"type": "float",
"value": 0.08
}
pull_pos={
"type": "vec3",
"value": Vector3(0, -10, 0)
}
pull_amt={
"type": "float",
"value": 0.0
}
pull_r={
"type": "float",
"value": 0.06
}
g_vn={
"type": "sampler2D",
"value": ""
}
g_fbm={
"type": "sampler2D",
"value": ""
}
g_c1={
"type": "sampler2D",
"value": ""
}
g_c2={
"type": "sampler2D",
"value": ""
}

[editor_plugins]

enabled=PackedStringArray("res://addons/gg_native/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://assets/i18n/strings.pt.translation", "res://assets/i18n/strings.en.translation", "res://assets/i18n/strings.es.translation")
locale/fallback="pt"
